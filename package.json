{
  "name": "after-effects-mcp",
  "version": "3.0.0",
  "description": "Motion Graphics Engine & MCP Platform for Adobe After Effects",
  "main": "build/index.js",
  "bin": {
    "motion-engine": "./bin/motion-engine.js"
  },
  "type": "module",
  "scripts": {
    "build": "tsc && copyfiles -u 1 \"src/scripts/**/*\" build && copyfiles -u 1 \"src/tests/**/*.json\" build",
    "test": "node --test build/tests/**/*.test.js",
    "conformance": "node scripts/run-conformance.mjs",
    "golden": "node --test build/tests/e2e/GoldenProject.test.js",
    "benchmark:100": "node scripts/run-benchmark100.mjs",
    "example:phase1": "node build/examples/phase-1-basic.js",
    "example:phase2": "node build/examples/phase-2-elements.js",
    "start": "node build/index.js",
    "install-bridge": "node install-bridge.js",
    "postinstall": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "node-fetch": "^3.3.2",
    "zod": "^3.22.2"
  },
  "devDependencies": {
    "@types/node": "^20.17.30",
    "copyfiles": "^2.4.1",
    "fast-check": "^4.9.0",
    "typescript": "^5.2.2"
  }
}
